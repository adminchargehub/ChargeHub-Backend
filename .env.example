# Copy to .env and adjust. Never commit .env.

# --- Database ---------------------------------------------------------------
# Matches docker-compose.yml. Driver must be asyncpg.
# Host port 55432: this machine already has 5432 (falcon-postgres container)
# and 5433 (a native Windows Postgres service) in use.
DATABASE_URL=postgresql+asyncpg://chargehub:chargehub@localhost:55432/chargehub

# --- Auth -------------------------------------------------------------------
# Generate a real one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- App --------------------------------------------------------------------
ENVIRONMENT=development
# Comma-separated. The Vite dev server default is 5173.
CORS_ORIGINS=http://localhost:5173
